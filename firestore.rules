rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read their own balance but never write it (the server does that).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Users can file a payout request only if they actually have the points.
    match /payouts/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.points >= 1000
        && request.resource.data.points == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.points;
      allow read, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
